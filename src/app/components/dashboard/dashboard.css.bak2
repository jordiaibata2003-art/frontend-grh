/* ===== CARTES ET HOVER ===== */
.hover-card {
  transition: all 0.2s ease;
  cursor: pointer;
}

.hover-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12) !important;
}

.card {
  border-radius: 16px;
  transition: all 0.2s ease;
}

.rounded-circle {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-muted.small {
  font-size: 0.7rem;
  letter-spacing: 0.5px;
}

.h4 {
  font-size: 1.6rem;
}

.bg-opacity-10 {
  --bs-bg-opacity: 0.1;
}
.bg-opacity-25 {
  --bs-bg-opacity: 0.2;
}

/* ===== BOUTON ACCUEIL PERSONNALISÉ ===== */
.btn-accueil {
  background: #1e437a;  /* Bleu par défaut */
  color: white;
  border: none;
  border-radius: 50px;
  padding: 14px 32px;
  font-size: 1.1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: all 0.3s ease;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(34, 88, 170, 0.3);
  text-decoration: none;
}

.btn-accueil:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(42, 98, 182, 0.4);
}

.btn-accueil i {
  font-size: 1.2rem;
}

/* ===== VARIANTES DE COULEURS POUR LE BOUTON ===== */
.btn-accueil.vert {
  background: #198754;
  box-shadow: 0 4px 12px rgba(25, 135, 84, 0.3);
}
.btn-accueil.vert:hover {
  box-shadow: 0 8px 25px rgba(25, 135, 84, 0.4);
}

.btn-accueil.rouge {
  background: #dc3545;
  box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
}
.btn-accueil.rouge:hover {
  box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
}

.btn-accueil.orange {
  background: #fd7e14;
  box-shadow: 0 4px 12px rgba(253, 126, 20, 0.3);
}
.btn-accueil.orange:hover {
  box-shadow: 0 8px 25px rgba(253, 126, 20, 0.4);
}

.btn-accueil.violet {
  background: #6f42c1;
  box-shadow: 0 4px 12px rgba(111, 66, 193, 0.3);
}
.btn-accueil.violet:hover {
  box-shadow: 0 8px 25px rgba(111, 66, 193, 0.4);
}

.btn-accueil.noir {
  background: #1a2a3a;
  box-shadow: 0 4px 12px rgba(26, 42, 58, 0.3);
}
.btn-accueil.noir:hover {
  box-shadow: 0 8px 25px rgba(26, 42, 58, 0.4);
}

.btn-accueil.rose {
  background: #d63384;
  box-shadow: 0 4px 12px rgba(214, 51, 132, 0.3);
}
.btn-accueil.rose:hover {
  box-shadow: 0 8px 25px rgba(214, 51, 132, 0.4);
}