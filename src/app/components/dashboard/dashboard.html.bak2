<div class="container-fluid px-4 py-4">

  <!-- EN-TÊTE AVEC BIENVENUE -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="fw-bold text-primary mb-1">📊 Tableau de bord</h1>
      
    </div>
    <div>
      <button class="btn btn-primary btn-lg px-4 py-3 fs-5 fw-bold shadow-sm" routerLink="/" style="border-radius: 50px;">
  <i class="fas fa-home me-2"></i> Accueil
</button>

    </div>
  </div>

  <!-- STATISTIQUES RAPIDES (5 cartes) -->
  <div class="row g-3 mb-4">
    <div class="col-xl col-md-4 col-6">
      <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small text-uppercase fw-bold">Employés</div>
            <div class="h4 fw-bold mb-0">{{ totalEmployes }}</div>
          </div>
          <div class="bg-primary bg-opacity-25 p-3 rounded-circle">
            <i class="fas fa-users text-primary fa-lg"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl col-md-4 col-6">
      <div class="card border-0 shadow-sm bg-success bg-opacity-10">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small text-uppercase fw-bold">Contrats</div>
            <div class="h4 fw-bold mb-0">{{ totalContrats }}</div>
          </div>
          <div class="bg-success bg-opacity-25 p-3 rounded-circle">
            <i class="fas fa-file-contract text-success fa-lg"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl col-md-4 col-6">
      <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small text-uppercase fw-bold">Congés</div>
            <div class="h4 fw-bold mb-0">{{ totalConges }}</div>
          </div>
          <div class="bg-warning bg-opacity-25 p-3 rounded-circle">
            <i class="fas fa-calendar-alt text-warning fa-lg"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl col-md-4 col-6">
      <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small text-uppercase fw-bold">Paies</div>
            <div class="h4 fw-bold mb-0">{{ totalPaies }}</div>
          </div>
          <div class="bg-danger bg-opacity-25 p-3 rounded-circle">
            <i class="fas fa-money-bill-wave text-danger fa-lg"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Carte Présences -->
    <div class="col-xl col-md-4 col-6">
      <div class="card border-0 shadow-sm bg-info bg-opacity-10">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small text-uppercase fw-bold">Présences</div>
            <div class="h4 fw-bold mb-0">{{ totalPresences }}</div>
          </div>
          <div class="bg-info bg-opacity-25 p-3 rounded-circle">
            <i class="fas fa-clock text-info fa-lg"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ACCÈS RAPIDE -->
  <div class="row g-3 mt-2">
    <div class="col-12">
      <h5 class="fw-bold text-secondary mb-3">⚡ Accès rapide</h5>
    </div>

    <div class="col-md-2 col-4">
      <a routerLink="/employes" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center py-3 hover-card">
          <i class="fas fa-users text-primary fa-2x mb-2"></i>
          <small class="fw-bold">Employés</small>
        </div>
      </a>
    </div>

    <div class="col-md-2 col-4">
      <a routerLink="/contrats" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center py-3 hover-card">
          <i class="fas fa-file-contract text-success fa-2x mb-2"></i>
          <small class="fw-bold">Contrats</small>
        </div>
      </a>
    </div>

    <div class="col-md-2 col-4">
      <a routerLink="/conges" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center py-3 hover-card">
          <i class="fas fa-calendar-alt text-warning fa-2x mb-2"></i>
          <small class="fw-bold">Congés</small>
        </div>
      </a>
    </div>

    <div class="col-md-2 col-4">
      <a routerLink="/paies" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center py-3 hover-card">
          <i class="fas fa-money-bill-wave text-danger fa-2x mb-2"></i>
          <small class="fw-bold">Paies</small>
        </div>
      </a>
    </div>

    <div class="col-md-2 col-4">
      <a routerLink="/presences" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center py-3 hover-card">
          <i class="fas fa-clock text-info fa-2x mb-2"></i>
          <small class="fw-bold">Présences</small>
        </div>
      </a>
    </div>
  </div>

</div>