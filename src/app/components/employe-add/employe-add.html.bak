<div class="container mt-4">

  <h2 class="fw-bold mb-4">
    <i class="fas fa-user-plus"></i>
    {{ isEditMode ? 'Modifier un employé' : 'Ajouter un employé' }}
  </h2>

  <div class="card shadow-sm p-4">

    <form (ngSubmit)="onSubmit()">

      <!-- Matricule -->
      <div class="mb-3">
        <label class="form-label fw-bold">Matricule</label>
        <input type="text" class="form-control" [(ngModel)]="employe.matricule" name="matricule" required>
      </div>

      <!-- Nom -->
      <div class="mb-3">
        <label class="form-label fw-bold">Nom</label>
        <input type="text" class="form-control" [(ngModel)]="employe.nom" name="nom" required>
      </div>

      <!-- Prénom -->
      <div class="mb-3">
        <label class="form-label fw-bold">Prénom</label>
        <input type="text" class="form-control" [(ngModel)]="employe.prenom" name="prenom" required>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <input type="email" class="form-control" [(ngModel)]="employe.email" name="email" required>
      </div>

      <!-- Date d'embauche -->
      <div class="mb-3">
        <label class="form-label fw-bold">Date d'embauche</label>
        <input type="date" class="form-control" [(ngModel)]="employe.dateEmbauche" name="dateEmbauche" required>
      </div>

      <!-- Poste -->
      <div class="mb-3">
        <label class="form-label fw-bold">Poste</label>
        <input type="text" class="form-control" [(ngModel)]="employe.poste" name="poste" required>
      </div>

      <!-- Département -->
      <div class="mb-3">
        <label class="form-label fw-bold">Département</label>
        <input type="text" class="form-control" [(ngModel)]="employe.departement" name="departement">
      </div>

      <!-- Boutons -->
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i>
          {{ isEditMode ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a routerLink="/employes" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>

    </form>

  </div>

</div>