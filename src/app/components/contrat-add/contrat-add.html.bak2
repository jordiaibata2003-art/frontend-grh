<div class="container mt-4">

  <h2 class="fw-bold mb-4">
    <i class="fas fa-file-contract"></i>
    {{ isEditMode ? 'Modifier un contrat' : 'Ajouter un contrat' }}
  </h2>

  <div class="card shadow-sm p-4">

    <form (ngSubmit)="onSubmit()">

      <div class="mb-3">
        <label class="form-label fw-bold">Employé</label>
        <select class="form-select" [(ngModel)]="contrat.employe_id" name="employe_id" required>
          <option value="">Sélectionner un employé</option>
          <option *ngFor="let employe of employes" [value]="employe.id">
            {{ employe.nom }} {{ employe.prenom }} ({{ employe.matricule }})
          </option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Type de contrat</label>
        <select class="form-select" [(ngModel)]="contrat.typeContrat" name="typeContrat" required>
          <option value="">Sélectionner un type</option>
          <option value="CDI">CDI</option>
          <option value="CDD">CDD</option>
          <option value="VACATAIRE">Vacataire</option>
          <option value="STAGE">Stage</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Date de début</label>
        <input type="date" class="form-control" [(ngModel)]="contrat.dateDebut" name="dateDebut" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Date de fin</label>
        <input type="date" class="form-control" [(ngModel)]="contrat.dateFin" name="dateFin">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Salaire (FCFA)</label>
        <input type="number" class="form-control" [(ngModel)]="contrat.salaire" name="salaire" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Statut</label>
        <select class="form-select" [(ngModel)]="contrat.statut" name="statut">
          <option value="actif">Actif</option>
          <option value="expire">Expiré</option>
          <option value="termine">Terminé</option>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i>
          {{ isEditMode ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a routerLink="/contrats" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>

    </form>

  </div>

</div>
