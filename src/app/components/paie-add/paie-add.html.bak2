<div class="container mt-4">
  <h2 class="fw-bold mb-4">
    <i class="fas fa-money-bill-wave"></i>
    {{ isEditMode ? 'Modifier une paie' : 'Nouvelle paie' }}
  </h2>

  <div class="card shadow-sm p-4">
    <form (ngSubmit)="onSubmit()">

      <div class="mb-3">
        <label class="form-label fw-bold">Employé</label>
        <select class="form-select" [(ngModel)]="paie.employe_id" name="employe_id" required>
          <option value="">Sélectionner un employé</option>
          <option *ngFor="let employe of employes" [value]="employe.id">
            {{ employe.nom }} {{ employe.prenom }}
          </option>
        </select>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Mois</label>
          <input type="number" class="form-control" [(ngModel)]="paie.mois" name="mois" min="1" max="12" required>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Année</label>
          <input type="number" class="form-control" [(ngModel)]="paie.annee" name="annee" required>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Salaire de base (FCFA)</label>
        <input type="number" class="form-control" [(ngModel)]="paie.salaireBase" name="salaireBase" required>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Prime (FCFA)</label>
          <input type="number" class="form-control" [(ngModel)]="paie.prime" name="prime">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Heures sup. (FCFA)</label>
          <input type="number" class="form-control" [(ngModel)]="paie.heuresSupplementaires" name="heuresSupplementaires">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Retenues (FCFA)</label>
        <input type="number" class="form-control" [(ngModel)]="paie.retenues" name="retenues">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Statut</label>
        <select class="form-select" [(ngModel)]="paie.statut" name="statut">
          <option value="preparer">Préparer</option>
          <option value="valide">Validé</option>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> {{ isEditMode ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a routerLink="/paies" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>

    </form>
  </div>
</div>
