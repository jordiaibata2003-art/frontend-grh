<div class="container mt-4">
  <h2 class="fw-bold mb-4">
    <i class="fas fa-clock"></i>
    {{ isEditMode ? 'Modifier une présence' : 'Nouvelle présence' }}
  </h2>

  <div class="card shadow-sm p-4">
    <form (ngSubmit)="onSubmit()">

      <div class="mb-3">
        <label class="form-label fw-bold">Employé</label>
        <select class="form-select" [(ngModel)]="presence.employe_id" name="employe_id" required>
          <option value="">Sélectionner un employé</option>
          <option *ngFor="let employe of employes" [value]="employe.id">
            {{ employe.nom }} {{ employe.prenom }}
          </option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Date</label>
        <input type="date" class="form-control" [(ngModel)]="presence.date" name="date" required>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Heure d'arrivée</label>
          <input type="time" class="form-control" [(ngModel)]="presence.heureArrivee" name="heureArrivee">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label fw-bold">Heure de départ</label>
          <input type="time" class="form-control" [(ngModel)]="presence.heureDepart" name="heureDepart">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Statut</label>
        <select class="form-select" [(ngModel)]="presence.statut" name="statut" required>
          <option value="present">Présent</option>
          <option value="absent">Absent</option>
          <option value="retard">Retard</option>
        </select>
      </div>

      <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" [(ngModel)]="presence.estJustifie" name="estJustifie" id="justifie">
        <label class="form-check-label fw-bold" for="justifie">Absence justifiée</label>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> {{ isEditMode ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a routerLink="/presences" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>

    </form>
  </div>
</div>
