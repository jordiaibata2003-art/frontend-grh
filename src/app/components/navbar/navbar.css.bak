.navbar-app {
  background: #1a2a3a;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 30px;
  max-width: 1400px;
  margin: 0 auto;
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: white;
  text-decoration: none;
  font-size: 1.3rem;
  font-weight: 800;
}

.navbar-logo i {
  color: #6366f1;
  font-size: 1.6rem;
}

.navbar-links {
  display: flex;
  list-style: none;
  gap: 8px;
  margin: 0;
  padding: 0;
}

.navbar-links a {
  display: flex;
  align-items: center;
  gap: 6px;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 500;
  transition: all 0.2s ease;
}

.navbar-links a:hover {
  background: rgba(255, 255, 255, 0.1);
  color: white;
}

.navbar-links a.active {
  background: #4f46e5;
  color: white;
}

.btn-logout {
  background: rgba(220, 38, 38, 0.15);
  color: #f87171;
  border: 1px solid rgba(220, 38, 38, 0.3);
  padding: 8px 16px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}

.btn-logout:hover {
  background: #dc2626;
  color: white;
}

@media (max-width: 768px) {
  .navbar-content {
    flex-direction: column;
    gap: 12px;
    padding: 12px;
  }
  .navbar-links {
    flex-wrap: wrap;
    justify-content: center;
  }
  .navbar-links a {
    font-size: 0.8rem;
    padding: 6px 10px;
  }
}