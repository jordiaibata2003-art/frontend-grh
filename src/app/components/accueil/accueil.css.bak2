.landing-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #d2d3d6 0%, #47679b 100%);
}

/* ==================== NAVBAR ==================== */
.navbar-landing {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 60px;
  background: white;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1.4rem;
  font-weight: 800;
  color: #1a2a3a;
}

.logo i {
  color: #4f46e5;
  font-size: 1.8rem;
}

.btn-login-nav {
  background: #1a2a3a;
  color: white;
  padding: 10px 24px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.btn-login-nav:hover {
  background: #2c3e50;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(26, 42, 58, 0.3);
  color: white;
}

/* ==================== HERO ==================== */
.hero {
  padding: 50px 60px 40px;
  text-align: center;
}

.hero-content {
  max-width: 800px;
  margin: 0 auto;
}

.badge-hero {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(79, 70, 229, 0.1);
  color: #4f46e5;
  padding: 8px 18px;
  border-radius: 50px;
  font-weight: 600;
  font-size: 0.85rem;
  margin-bottom: 20px;
}

.badge-hero i {
  font-size: 0.9rem;
}

.hero-content h1 {
  font-size: 2.8rem;
  font-weight: 800;
  color: #1a2a3a;
  line-height: 1.15;
  margin-bottom: 12px;
}

.subtitle {
  font-size: 1.2rem;
  color: #4f46e5;
  font-weight: 600;
  margin-bottom: 20px;
}

.description {
  font-size: 1rem;
  color: #5a6a7a;
  line-height: 1.6;
  margin-bottom: 28px;
}

.hero-buttons {
  margin-bottom: 28px;
}

.btn-primary-hero {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: white;
  padding: 14px 32px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(79, 70, 229, 0.3);
}

.btn-primary-hero:hover {
  transform: translateY(-3px);
  box-shadow: 0 15px 40px rgba(79, 70, 229, 0.4);
  color: white;
}

/* ==================== BOUTONS COLORÉS ==================== */
.hero-stats {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.stat-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 50px;
  font-size: 0.9rem;
  font-weight: 600;
  transition: all 0.3s ease;
  cursor: default;
  border: 1.5px solid transparent;
}

.stat-button i {
  font-size: 1rem;
}

.stat-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
}

.stat-blue {
  background: rgba(79, 70, 229, 0.1);
  color: #4f46e5;
  border-color: rgba(79, 70, 229, 0.2);
}

.stat-green {
  background: rgba(5, 150, 105, 0.1);
  color: #059669;
  border-color: rgba(5, 150, 105, 0.2);
}

.stat-orange {
  background: rgba(217, 119, 6, 0.1);
  color: #d97706;
  border-color: rgba(217, 119, 6, 0.2);
}

/* ==================== FEATURES ==================== */
.features {
  padding: 40px 60px 60px;
  text-align: center;
}

.features h2 {
  font-size: 1.8rem;
  color: #1a2a3a;
  font-weight: 800;
  margin-bottom: 32px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.feature-card {
  padding: 24px 20px;
  border-radius: 18px;
  transition: all 0.3s ease;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  text-align: center;
}

.feature-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
}

.feature-icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  margin: 0 auto 14px auto;
}

.feature-card h3 {
  font-size: 1rem;
  color: #1a2a3a;
  font-weight: 700;
  margin-bottom: 6px;
}

.feature-card p {
  color: #5a6a7a;
  font-size: 0.85rem;
  margin: 0;
  line-height: 1.4;
}

/* Couleurs des cartes */
.feature-blue { background: linear-gradient(135deg, #eef2ff, #e0e7ff); }
.feature-blue .feature-icon { background: rgba(79, 70, 229, 0.15); color: #4f46e5; }

.feature-green { background: linear-gradient(135deg, #ecfdf5, #d1fae5); }
.feature-green .feature-icon { background: rgba(5, 150, 105, 0.15); color: #059669; }

.feature-orange { background: linear-gradient(135deg, #fffbeb, #fef3c7); }
.feature-orange .feature-icon { background: rgba(217, 119, 6, 0.15); color: #d97706; }

.feature-red { background: linear-gradient(135deg, #fef2f2, #fecaca); }
.feature-red .feature-icon { background: rgba(220, 38, 38, 0.15); color: #dc2626; }

.feature-cyan { background: linear-gradient(135deg, #ecfeff, #cffafe); }
.feature-cyan .feature-icon { background: rgba(8, 145, 178, 0.15); color: #0891b2; }

.feature-purple { background: linear-gradient(135deg, #f5f3ff, #ede9fe); }
.feature-purple .feature-icon { background: rgba(124, 58, 237, 0.15); color: #7c3aed; }

/* ==================== FOOTER ==================== */
.footer-landing {
  text-align: center;
  padding: 24px 20px;
  background: #1a2a3a;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.85rem;
}

.footer-landing p {
  margin: 4px 0;
}

/* ==================== RESPONSIVE ==================== */
@media (max-width: 768px) {
  .navbar-landing { padding: 14px 20px; }
  .hero { padding: 30px 20px; }
  .hero-content h1 { font-size: 1.8rem; }
  .hero-stats { gap: 12px; }
  .stat-button { font-size: 0.8rem; padding: 8px 14px; }
  .features { padding: 30px 20px; }
  .features h2 { font-size: 1.4rem; }
}