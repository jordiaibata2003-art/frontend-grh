<div class="container mt-4">
  <h2 class="fw-bold mb-4">
    <i class="fas fa-calendar-plus"></i>
    {{ isEditMode ? 'Modifier un congé' : 'Nouveau congé' }}
  </h2>

  <div class="card shadow-sm p-4">
    <form (ngSubmit)="onSubmit()">

      <div class="mb-3">
        <label class="form-label fw-bold">Employé</label>
        <select class="form-select" [(ngModel)]="conge.employe_id" name="employe_id" required>
          <option value="">Sélectionner un employé</option>
          <option *ngFor="let employe of employes" [value]="employe.id">
            {{ employe.nom }} {{ employe.prenom }}
          </option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Type de congé</label>
        <select class="form-select" [(ngModel)]="conge.type" name="type" required>
          <option value="">Sélectionner</option>
          <option value="annuel">Annuel</option>
          <option value="maladie">Maladie</option>
          <option value="exceptionnel">Exceptionnel</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Date de début</label>
        <input type="date" class="form-control" [(ngModel)]="conge.dateDebut" name="dateDebut" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Date de fin</label>
        <input type="date" class="form-control" [(ngModel)]="conge.dateFin" name="dateFin" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Motif</label>
        <textarea class="form-control" [(ngModel)]="conge.motif" name="motif"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Statut</label>
        <select class="form-select" [(ngModel)]="conge.statut" name="statut">
          <option value="en_attente">En attente</option>
          <option value="valide">Validé</option>
          <option value="refuse">Refusé</option>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> {{ isEditMode ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a routerLink="/conges" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Annuler
        </a>
      </div>

    </form>
  </div>
</div>
