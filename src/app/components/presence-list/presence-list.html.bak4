<div class="container py-4">

  <div class="page-header">
    <div>
      <h2><i class="fas fa-clock text-primary me-2"></i>Présences</h2>
      <p class="page-subtitle">Pointages, retards et absences</p>
    </div>
    <button class="btn btn-primary" routerLink="/presences/add">
      <i class="fas fa-plus me-2"></i>Nouvelle présence
    </button>
  </div>

  <div class="toolbar">
    <div class="input-group search-box">
      <span class="input-group-text"><i class="fas fa-search"></i></span>
      <input type="text" class="form-control" placeholder="Rechercher par employé, statut..." [(ngModel)]="recherche">
    </div>
    <span class="count-pill">{{ presencesFiltres.length }} présence(s)</span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Employé</th>
          <th>Date</th>
          <th>Arrivée</th>
          <th>Départ</th>
          <th>Statut</th>
          <th>Justifié</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let presence of presencesFiltres">
          <td><span class="matricule">#{{ presence.id }}</span></td>
          <td class="fw-semibold text-dark">{{ presence.employe?.nom }} {{ presence.employe?.prenom }}</td>
          <td>{{ presence.date | date:'dd/MM/yyyy' }}</td>
          <td>{{ presence.heureArrivee }}</td>
          <td>{{ presence.heureDepart }}</td>
          <td>
            <span class="badge text-capitalize" [ngClass]="{
              'badge-soft-success': presence.statut === 'present',
              'badge-soft-warning': presence.statut === 'retard',
              'badge-soft-danger': presence.statut === 'absent'
            }">{{ presence.statut }}</span>
          </td>
          <td>
            <span class="badge" [ngClass]="{
              'badge-soft-success': presence.estJustifie,
              'badge-soft-danger': !presence.estJustifie
            }">{{ presence.estJustifie ? 'Oui' : 'Non' }}</span>
          </td>
          <td class="text-center text-nowrap">
            <button class="btn btn-sm btn-icon btn-soft-warning me-1" title="Modifier" (click)="modifierPresence(presence.id)">
              <i class="fas fa-pen"></i>
            </button>
            <button class="btn btn-sm btn-icon btn-soft-danger" title="Supprimer" (click)="supprimerPresence(presence.id)">
              <i class="fas fa-trash-alt"></i>
            </button>
          </td>
        </tr>
        <tr *ngIf="presencesFiltres.length === 0">
          <td colspan="8" class="empty-state">
            <i class="fas fa-inbox"></i>
            <div>Aucune présence trouvée.</div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</div>