<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">⏱️ Liste des présences</h2>
    <button class="btn btn-primary" routerLink="/presences/add">
      <i class="fas fa-plus-circle"></i> Nouvelle présence
    </button>
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="text" class="form-control" placeholder="Rechercher par employé, statut..." [(ngModel)]="recherche">
      </div>
    </div>
    <div class="col-md-6 text-end">
      <span class="badge bg-secondary">{{ presencesFiltres.length }} présence(s) trouvée(s)</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-dark">
        <tr>
          <th>ID</th>
          <th>Employé</th>
          <th>Date</th>
          <th>Heure arrivée</th>
          <th>Heure départ</th>
          <th>Statut</th>
          <th>Justifié</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let presence of presencesFiltres">
          <td><strong>{{ presence.id }}</strong></td>
          <td>{{ presence.employe?.nom }} {{ presence.employe?.prenom }}</td>
          <td>{{ presence.date | date:'dd/MM/yyyy' }}</td>
          <td>{{ presence.heureArrivee }}</td>
          <td>{{ presence.heureDepart }}</td>
          <td>
            <span class="badge" [ngClass]="{
              'bg-success': presence.statut === 'present',
              'bg-warning text-dark': presence.statut === 'retard',
              'bg-danger': presence.statut === 'absent'
            }">{{ presence.statut }}</span>
          </td>
          <td>
            <span class="badge" [ngClass]="{
              'bg-success': presence.estJustifie,
              'bg-danger': !presence.estJustifie
            }">{{ presence.estJustifie ? 'Oui' : 'Non' }}</span>
          </td>
          <td class="text-center">
            <button class="btn btn-sm btn-warning me-1" (click)="modifierPresence(presence.id)">
              <i class="fas fa-edit"></i>
            </button>
            <button class="btn btn-sm btn-danger" (click)="supprimerPresence(presence.id)">
              <i class="fas fa-trash-alt"></i>
            </button>
          </td>
        </tr>
        <tr *ngIf="presencesFiltres.length === 0">
          <td colspan="8" class="text-center text-muted py-4">
            <i class="fas fa-inbox fa-2x d-block mb-2"></i>
            Aucune présence trouvée.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

</div>