.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a2a3a 0%, #2c3e50 100%);
  padding: 20px;
}

.login-card {
  background: white;
  border-radius: 24px;
  padding: 40px;
  width: 100%;
  max-width: 440px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.login-logo {
  text-align: center;
  margin-bottom: 30px;
}

.login-logo i {
  font-size: 3.5rem;
  color: #4f46e5;
  margin-bottom: 12px;
}

.login-logo h1 {
  font-size: 1.8rem;
  font-weight: 800;
  color: #1a2a3a;
  margin: 0;
}

.login-logo p {
  color: #8a9aaa;
  font-size: 0.9rem;
  margin-top: 4px;
}

h2 {
  font-size: 1.3rem;
  color: #1a2a3a;
  text-align: center;
  margin-bottom: 24px;
  font-weight: 700;
}

.alert-error {
  background: #fee;
  color: #c00;
  padding: 12px 16px;
  border-radius: 10px;
  margin-bottom: 20px;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-weight: 600;
  color: #4a5a6a;
  margin-bottom: 8px;
  font-size: 0.9rem;
}

.form-group label i {
  margin-right: 6px;
  color: #4f46e5;
}

.form-control {
  width: 100%;
  padding: 14px 16px;
  border: 2px solid #e5e7eb;
  border-radius: 12px;
  font-size: 1rem;
  transition: all 0.2s ease;
}

.form-control:focus {
  outline: none;
  border-color: #4f46e5;
  box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
}

.btn-login {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 10px;
}

.btn-login:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(79, 70, 229, 0.4);
}

.btn-login:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.back-home {
  display: block;
  text-align: center;
  margin-top: 24px;
  color: #8a9aaa;
  text-decoration: none;
  font-size: 0.9rem;
  transition: color 0.2s ease;
}

.back-home:hover {
  color: #4f46e5;
}